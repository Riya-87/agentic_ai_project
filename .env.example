# Academic Intelligence Agent Environment Configuration

# Database Configuration
# Local SQLite (Default out-of-the-box): sqlite:///./academic_intelligence.db
# PostgreSQL (Production / Docker): postgresql://postgres:postgrespassword@localhost:5432/academic_intelligence
DATABASE_URL=sqlite:///./academic_intelligence.db

# Secret key for JWT Token generation
SECRET_KEY=academic_intelligence_secret_key_super_secure_2026_change_in_prod

# Google Gemini API Key (Optional for production LLM generation; system includes robust structured heuristics fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
VITE_API_URL=/api/v1
